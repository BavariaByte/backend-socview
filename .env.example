# ============================================================================
# GIRP Backend-SOCView — environment configuration
# Copy this file to .env and fill in the values for your deployment.
# ============================================================================

# ========= SERVER =========
PORT=3000

# Environment — accepted values: "production" / "prod"  OR  "development" / "dev".
# Anything else hard-fails on startup. In development mode, every authenticated
# user is treated as admin (convenience for local testing). In production mode,
# only the SUPER_ADMIN_EMAIL is the initial admin.
NODE_ENV=development

# Logging level: debug | info | warn | error | silent (default: info)
# debug/trace: all requests incl. 2xx/3xx; info/warn/error: errors only
LOG_LEVEL=info

# ========= DATABASE =========
# IMPORTANT: all GIRP services share ONE database — the database name here
# MUST be identical to the one in backend-inputform/.env, otherwise the
# InputForm will not see playbooks created in SOCView.
# Ticket live updates use MongoDB change streams, which require a replica
# set (?replicaSet=rs0) — a standalone mongod without one starts fine, but
# live updates silently do nothing.
# MongoDB URI — without auth (local dev, no Docker):
MONGODB_URI=mongodb://localhost:27017/girp_db?replicaSet=rs0
# MongoDB URI — with auth (Docker / production):
# MONGODB_URI=mongodb://<app_user>:<app_password>@localhost:27017/girp_db?replicaSet=rs0&authSource=girp_db

# ========= HOSTING =========
# Public-facing URL of the GIRP SOCView frontend (no trailing slash)
# In prod: e.g. https://socview.example.com
PLATFORM_URL=http://localhost:5173
# Public-facing URL of the Frontend-Inputform (trusted origin for Better-Auth)
INPUTFORM_URL=http://localhost:4173
# URL of the Formbuilder (used to build the "Edit Playbook" deep link).
# The hosted editor https://builder.girp.bavariabyte.com is used automatically
# in production when this variable is unset.
FORMBUILDER_URL=http://localhost:8080

# ========= ADMIN PANEL =========
# Super admin email — this user gets the protected super_admin role (NODE_ENV=prod)
SUPER_ADMIN_EMAIL=admin@example.com

# How long soft-deleted tickets are kept before permanent removal (days, default 365)
TICKET_RETENTION_DAYS=365

# ==========================================
# Platform update check
# ==========================================
# Checks the container registry every few days for a newer GIRP release and
# notifies admins by mail plus a dialog on login. Set to false in air-gapped
# installations.
UPDATE_CHECK_ENABLED=true
UPDATE_CHECK_INTERVAL_DAYS=3
UPDATE_CHECK_REGISTRY=docker.bavariabyte.com
UPDATE_CHECK_IMAGES=backend-socview,frontend-socview,backend-inputform,frontend-inputform
UPDATE_CHECK_TAG=latest
UPDATE_DOCS_URL=https://docs.girp.bavariabyte.com/s/efa5a8ab-bdda-4a37-881e-a5a9738afb90/doc/installation-iSNLxkXN9r#h-dienste-aktualisieren
# Overrides the version this instance reports (defaults to its package version)
# GIRP_VERSION=

# ========= CSRF =========
# Secret used to derive double-submit CSRF tokens. STRONGLY recommended in
# production: without it a per-process random fallback is used, which means
# (a) all CSRF tokens become invalid on every restart, and
# (b) tokens issued by one replica are rejected by other replicas.
# Generate with: openssl rand -hex 32
CSRF_SECRET=

# ========= AUTH: AZURE / ENTRA ID =========
AUTH_AZURE_ENABLED=true
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
# Restrict to specific tenants (comma-separated GUIDs) — REQUIRED in production
# when AUTH_AZURE_ENABLED=true and the tenant is multi-tenant (common/organizations).
ALLOWED_TENANTS=

# ========= AUTH: BETTER-AUTH (Multi-SSO) =========
AUTH_BETTERAUTH_ENABLED=false

# Base URL of this backend as the browser sees it (NOT the internal Docker hostname)
BETTER_AUTH_URL=http://localhost:3000

# Secret for session encryption (min. 32 characters)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Cross-subdomain cookie domain (e.g. .girp.example.com) — required when SOCView
# and Inputform run on different subdomains. Leave empty for local dev (same-origin).
BETTER_AUTH_COOKIE_DOMAIN=

# --- Google OAuth ---
# Console: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Slack OAuth (SSO login) ---
# Apps: https://api.slack.com/apps
# Redirect URI: http://localhost:3000/api/auth/callback/slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ========= AUTH: AUTH0 =========
AUTH_AUTH0_ENABLED=false
AUTH0_OIDC_ISSUER=""          # IMPORTANT: with trailing slash
AUTH0_OIDC_AUDIENCE=""        # optional: multiple, comma-separated

# ========= NOTIFICATIONS =========
# --- Email: SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# Central alert email address (always notified regardless of user preferences)
NOTIFY_EMAIL=

# --- Slack (Web API, OAuth Bot Token) ---
# Create a Slack App at api.slack.com/apps, add Bot Token Scope "chat:write",
# install the app to your workspace, then invite the bot to the target channel.
# Separate from the Slack OAuth SSO login configured above.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# --- Microsoft Teams (Power Automate Workflow Webhook, Adaptive Cards) ---
# Note: The Graph API has no Application permission for posting channel messages
# without a signed-in user. Power Automate Workflows are Microsoft's supported
# alternative for backend → Teams notifications.
# Setup: In Teams, open the target channel → "..." → "Workflows" →
# search "Post to a channel when a webhook request is received" → follow wizard
# → copy the generated webhook URL here.
NOTIFY_TEAMS_WORKFLOW_URL=

# --- PagerDuty Events API v2 ---
NOTIFY_PAGERDUTY_ROUTING_KEY=

# ============================================================================
# ADVANCED / OPTIONAL
# Rarely needed — leave commented unless you know you need them.
# ============================================================================

# --- Azure / Entra ID OIDC overrides (otherwise derived from AZURE_TENANT_ID
#     via OIDC discovery) ---
# AZURE_AUTHORITY=
# OIDC_ISSUER=
# OIDC_JWKS_URI=
# OIDC_AUDIENCE=
# Allowed clock skew for JWT validation, in seconds:
# OIDC_CLOCK_SKEW_SEC=

# --- Auth0 overrides ---
# JWKS URI override (otherwise resolved via OIDC discovery):
# AUTH0_OIDC_JWKS_URI=
# Claim mapping — defaults work with standard Auth0 RBAC setups:
# AUTH0_ROLES_CLAIM=permissions
# AUTH0_GROUPS_CLAIM=
# AUTH0_EMAIL_CLAIM=email

# --- Notifications ---
# Force SMTP auth method if the server rejects the default (PLAIN). Options: LOGIN, PLAIN, CRAM-MD5
# SMTP_AUTH_METHOD=

# --- Demo ONLY ---
# These flags enable the demo login (self-service accounts without email
# verification) used by the GIRP Launcher and the hosted demo. A demo instance
# may run with NODE_ENV=production — it then logs a loud warning at startup and
# shows the demo disclaimer on the login screen. AUTH_EMAIL_PASSWORD_ENABLED on
# its own, without DEMO_MODE, makes the server REFUSE TO START in production.
# DEMO_MODE=false
# AUTH_EMAIL_PASSWORD_ENABLED=false
